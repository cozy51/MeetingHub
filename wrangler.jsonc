{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meeting-hub",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // next build（静的出力）の成果物
    "directory": "./out",
    "not_found_handling": "404-page",
    // /api/* だけ Worker で処理し、それ以外は静的ファイルをそのまま返す
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meeting-hub",
      "database_id": "a7500f2d-d360-488f-a7b9-723b1729884f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Cloudflare Access のチーム ドメイン（例: your-team.cloudflareaccess.com）と
    // Access アプリケーションの Audience (AUD) タグ。未設定の間は API が 503 を返す
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
